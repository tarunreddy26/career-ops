# Copy to .env (which is gitignored). All values are OPTIONAL.
# gh handles GitHub auth on its own (run `gh auth login`) — there is no GitHub
# token to put here, by design. Keep secrets out of code.

# Default repo to operate on, as owner/name. If unset, scripts use the repo of
# the current git checkout.
# REPO=your-user/your-repo

# The AI step routes through Claude Code in headless mode. Override the binary
# name if yours isn't `claude`.
# CLAUDE_BIN=claude

# Extra args passed to the claude CLI on every AI call (advanced).
# CLAUDE_EXTRA_ARGS=
